{
  "name": "mongo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter web --filter server --fail-if-no-match dev:bare",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "test": "vp run -r test",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web --fail-if-no-match dev:bare",
    "dev:server": "vp run --filter server --fail-if-no-match dev:bare",
    "dev:infra": "vp run --filter @mongo/infra --fail-if-no-match dev",
    "db:push": "vp run --filter @mongo/db db:push",
    "db:studio": "vp run --filter @mongo/db db:studio",
    "db:generate": "vp run --filter @mongo/db db:generate",
    "db:migrate": "vp run --filter @mongo/db db:migrate",
    "build:web": "vp run --filter web build",
    "preview:pages": "wrangler pages dev",
    "deploy:pages": "vp run --filter web build && wrangler pages deploy",
    "deploy": "vp run --filter @mongo/infra deploy",
    "destroy": "vp run --filter @mongo/infra destroy",
    "env:generate": "node scripts/generate-env.mjs",
    "postinstall": "node scripts/generate-env.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mongo/config": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "1.2.7",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "0.3.1",
    "wrangler": "^4.140.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "packageManager": "pnpm@12.3.4"
}
